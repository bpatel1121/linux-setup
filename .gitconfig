	name = Brij Patel
	email = brijpatel2106012@gmail.com

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[alias]
	lg = log --pretty=format:'%C(yellow)%h%C(auto)%d %C(cyan)%an %C(green)%ar%C(reset) %s' --graph
