# User-local bin (local-run, claude, user installs)
export PATH="$HOME/.local/bin:$PATH"

# Oh My Zsh. No theme — starship draws the prompt (see the bottom of this file).
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""

# setup.sh owns this checkout; let it do the updating, not an interactive prompt.
zstyle ':omz:update' mode disabled

# zsh-autosuggestions / zsh-syntax-highlighting are cloned into $ZSH_CUSTOM/plugins
# by setup.sh — listing them here is what actually loads them.
# (syntax-highlighting must stay last; it wraps the line editor.)
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

ZSH_DISABLE_COMPFIX=true
source $ZSH/oh-my-zsh.sh

export EDITOR='nvim'
export VISUAL='nvim'

# Personal Aliases
alias gs='git status'
alias gl='git lg' #lg is in .gitconfig
alias glo='git lg --oneline -10'
alias ..='cd ..'
alias ~='cd ~'
alias vi='nvim'
alias ga.='git add .'
alias ga='git add'
alias gp='git push'
alias gcm='git commit -m'
alias ta='tmux attach -t'

# Safety Nets
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Convenience
alias c='clear'

# Disable Ctrl-S freeze
stty -ixon

#Zoxide
eval "$(zoxide init --cmd cd zsh)"

# Starship prompt — themed per-desktop-theme: theme-apply.sh symlinks
# ~/.config/starship.toml to the active theme's starship.toml. Guarded so a
# box without starship just keeps the oh-my-zsh prompt above.
command -v starship >/dev/null && eval "$(starship init zsh)"
